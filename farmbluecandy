-- Single-Target Lock System
local currentLockedTarget = nil

local function findSingleTarget()
    if currentLockedTarget and currentLockedTarget.Parent and currentLockedTarget:FindFirstChild("Humanoid") and currentLockedTarget.Humanoid.Health > 0 then
        return currentLockedTarget
    end

    local nearest = nil
    local shortestDistance = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            local isTarget = false
            for _, name in ipairs(CONFIG.TargetNames) do
                if string.find(obj.Name, name) and obj.Humanoid.Health > 0 then
                    isTarget = true
                    break
                end
            end

            if isTarget then
                local dist = (HumanoidRootPart.Position - obj.HumanoidRootPart.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    nearest = obj
                end
            end
        end
    end

    currentLockedTarget = nearest
    return nearest
end

-- Virtual Mouse Tap with 0.3s Cadence
local function simulateClick()
    local camera = Workspace.CurrentCamera
    if not camera then return end
    local viewportSize = camera.ViewportSize
    local targetX = viewportSize.X * 0.85
    local targetY = viewportSize.Y * 0.65

    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 1)
    end)
end

-- Main Execution Loop: 5-Stud Orbital Rotation + 0.3s M1 Clicks + Anti-AFK
local angle = 0
task.spawn(function()
    while true do
        RunService.RenderStepped:Wait()
        if CONFIG.Enabled then
            pcall(function()
                if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.CharacterAdded:Wait()
                    Character = LocalPlayer.Character
                    HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
                    return
                end

                HumanoidRootPart = LocalPlayer.Character.HumanoidRootPart
                local target = findSingleTarget()

                if target and target:FindFirstChild("HumanoidRootPart") then
                    local enemyRoot = target.HumanoidRootPart
                    StatusText.Text = "Status: Target: " .. target.Name .. "\nAttack btn: found"
                    
                    -- Calculate 5-stud orbital circle around target
                    angle = angle + (CONFIG.OrbitSpeed * RunService.RenderStepped:Wait())
                    local offsetX = math.cos(angle) * CONFIG.OrbitRadius
                    local offsetZ = math.sin(angle) * CONFIG.OrbitRadius
                    
                    local orbitalPosition = enemyRoot.Position + Vector3.new(offsetX, CONFIG.OrbitHeight, offsetZ)
                    HumanoidRootPart.CFrame = CFrame.new(orbitalPosition, enemyRoot.Position)

                    -- Execute M1 click with 0.3s interval cadence
                    simulateClick()
                    task.wait(CONFIG.ClickInterval)
                else
                    currentLockedTarget = nil
                    StatusText.Text = "Status: Searching target...\nAttack btn: found"
                end
            end)
        end
    end
end)
